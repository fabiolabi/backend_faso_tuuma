# ============================================================
#  Faso Tuuma — modèle de variables d'environnement
#  Usage : cp .env.example .env  puis renseigner les valeurs réelles.
#  Le .env réel est gitignoré : ne JAMAIS y committer de secret.
#  Ces variables remplacent les ${VAR} des application*.properties au lancement.
# ============================================================

# ---- PostgreSQL (service db du docker-compose) ----
POSTGRES_DB=fasotuuma
POSTGRES_USER=fasotuuma
POSTGRES_PASSWORD=fasotuuma
# Note : SPRING_DATASOURCE_URL/USERNAME/PASSWORD sont dérivées de ces valeurs
# dans docker-compose.yml (inutile de les redéfinir ici).

# ---- Authentification JWT ----
# JWT_SECRET : au moins 32 octets (256 bits) pour HMAC-SHA256.
JWT_SECRET=change-me-with-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ---- Réinitialisation de mot de passe ----
RESET_CODE_TTL=900

# ---- Serveur SMTP (requis en prod : app.mail.enabled=true) ----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=apikey-or-user
MAIL_PASSWORD=change-me-smtp
MAIL_FROM=no-reply@fasotuuma.bf

# ---- IA (Gemini) : notation auto + recherche sémantique ----
# AI_ENABLED=true active les appels réseau (nécessite GEMINI_API_KEY).
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ---- Notifications push (Firebase / FCM) ----
# NOTIFICATION_ENABLED=false => repli NoOp (aucun fichier Firebase requis).
# Pour activer : poser le JSON de compte de service à la racine sous
# firebase-service-account.json (monté en /app/... par le compose) et :
NOTIFICATION_ENABLED=false
FIREBASE_CREDENTIALS_FILE=/app/firebase-service-account.json
FIREBASE_PROJECT_ID=

# ---- Stockage media ----
# local = disque (dev) ; r2 = Cloudflare R2 (prod — voir env.production.example).
MEDIA_BACKEND=local
MEDIA_STORAGE_DIR=/app/data/media
MEDIA_MAX_SIZE=5242880
MEDIA_PUBLIC_BASE_URL=
MEDIA_MIGRATE_LOCAL_TO_R2=false

# ---- Cloudflare R2 (si MEDIA_BACKEND=r2) ----
# R2 est compatible API S3 — le backend utilise le SDK AWS S3 (normal).
# R2_ENDPOINT : URL du compte SANS le nom du bucket à la fin.
#   ✅ https://<account_id>.r2.cloudflarestorage.com
#   ❌ https://<account_id>.r2.cloudflarestorage.com/mon-bucket
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_AUTO_CREATE_BUCKET=false
