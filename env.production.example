# ============================================================
#  Faso Tuuma — PRODUCTION (tuuma.openbangre.com)
#  Usage sur le serveur : cp env.production.example .env  puis renseigner les secrets.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=fasotuuma
POSTGRES_USER=fasotuuma
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- JWT ----
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ---- Mail ----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@fasotuuma.bf

# ---- IA ----
AI_ENABLED=false
GEMINI_API_KEY=

# ---- Notifications ----
NOTIFICATION_ENABLED=false
FIREBASE_CREDENTIALS_FILE=/app/firebase-service-account.json
FIREBASE_PROJECT_ID=

# ---- Stockage media : Cloudflare R2 ----
MEDIA_BACKEND=r2
MEDIA_STORAGE_DIR=/app/data/media
MEDIA_MAX_SIZE=5242880
# URL publique R2 (domaine custom ou r2.dev) — laisser vide pour proxy /api/media/{id}
# Ex. https://pub-xxxxx.r2.dev  ou  https://media.tuuma.openbangre.com
MEDIA_PUBLIC_BASE_URL=

# Migration one-shot des fichiers locaux existants → R2 (true une seule fois, puis false)
MEDIA_MIGRATE_LOCAL_TO_R2=false

# ---- Cloudflare R2 (dashboard → R2 → Manage R2 API Tokens) ----
# IMPORTANT : R2 utilise l'API S3-compatible — le SDK AWS S3 est le bon choix.
# R2_ENDPOINT = URL du COMPTE uniquement (sans /nom-du-bucket à la fin) :
#   https://647bf97e2daad413ebbdc971db6ddba1.r2.cloudflarestorage.com
# R2_BUCKET   = nom du bucket créé dans Cloudflare R2 :
#   fasotuuma
R2_BUCKET=fasotuuma
R2_ENDPOINT=https://647bf97e2daad413ebbdc971db6ddba1.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_REGION=auto
# true = crée le bucket au 1er démarrage s'il n'existe pas encore
R2_AUTO_CREATE_BUCKET=true
